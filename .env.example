# FinLedger Environment Variables
NODE_ENV=development
PORT=5000
USE_MEMORY_DB=true
MONGO_URI=
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=change-me-in-production-32chars-minimum
JWT_REFRESH_SECRET=change-me-refresh-production-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FinLedger <noreply@finledger.local>
