# Production Server Environment Template (Render / Docker / VPS)
NODE_ENV=production
PORT=5000
USE_MEMORY_DB=false

# MongoDB Atlas Replica Set URI (required in production)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/finledger?retryWrites=true&w=majority

# Generate two distinct >= 32-char random secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-random-64-char-hex-secret
JWT_REFRESH_SECRET=replace-with-different-random-64-char-hex-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Deployed Frontend URL (no trailing slash)
CLIENT_URL=https://finledger-iota.vercel.app
CORS_ORIGIN=https://finledger-iota.vercel.app

# Transactional Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FinLedger <noreply@finledger.app>

# Optional: set SERVE_CLIENT=true for single-container deployment
SERVE_CLIENT=false
RECEIPTS_DIR=
